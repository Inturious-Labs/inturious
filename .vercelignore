# Draft decks (underscore-prefixed) — never deployed.
# Stripped at upload time, so build-decks.sh can't see them either —
# which is what we want (no build = no leaked URL).
decks/_*/

# Repo metadata. Only root-level docs; markdown inside products/ or decks/
# may be needed (slidev's slides.md), so don't use a broad *.md rule.
/README.md
/PLAN.md

# Dev tooling. node_modules is gitignored locally so it never enters the
# upload, but the build CREATES it inside the container. The buildCommand
# rm's it before Vercel uploads the artifact to CDN.
node_modules/
