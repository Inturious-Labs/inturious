# Draft decks (underscore-prefixed) — never deployed
# Note: this strips drafts BEFORE the build runs, so build-decks.sh
# also can't see them — which is what we want (no build = no leaked URL).
decks/_*/

# Public deck source folders are intentionally NOT excluded here.
# The build script needs them to produce decks/<slug>/index.html.
# After the build, src/ stays in the deploy filesystem and is reachable
# at /decks/<slug>/src/ — that's fine, the files are already public on GitHub.

# IC canister artifacts — kept in repo for rollback, not deployed to Vercel
.dfx/
dfx.json
canister_ids.json
.ic-assets.json5
.well-known/ic-domains

# Repo metadata not needed at runtime.
# Only the repo-root markdown is metadata; markdown inside products/ or decks/
# may be needed (e.g. slidev's slides.md). So we list the repo-root files
# explicitly instead of using a broad *.md rule that would catch them.
/README.md
/PLAN.md

# Dev tooling
node_modules/
pnpm-workspace.yaml
.github/
