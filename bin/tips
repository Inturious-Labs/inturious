#!/usr/bin/env python3
"""
Read tipping stats from the API.

  tips              overview
  tips top          articles by tip-page visits
  tips methods      which payment methods get clicked
  tips revenue      card tips (crypto cannot be attributed on-chain)
  tips week         last 7 days
  tips raw          full JSON

Needs INTURIOUS_STATS_TOKEN. INTURIOUS_API overrides the default host.
"""
import datetime
import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("INTURIOUS_API", "https://api.inturious.com")
TOKEN = os.environ.get("INTURIOUS_STATS_TOKEN", "")


def fetch(days=None):
    url = f"{API}/api/tips/stats" + (f"?days={days}" if days else "")
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {TOKEN}"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def money(cents):
    return f"{cents / 100:.2f}"


def overview(d):
    span = "all time" if not d["since"] else f"since {datetime.date.fromtimestamp(d['since'])}"
    print(f"Tip page visits ({span}): {d['visits_total']}")
    if d["by_source"]:
        print("\nBy newsletter:")
        for r in d["by_source"]:
            print(f"  {r['visits']:>6}  {r['src']}")
    if d["by_method"]:
        print("\nMethod clicks:")
        for r in d["by_method"]:
            print(f"  {r['clicks']:>6}  {r['method']}")
    if d["top_articles"]:
        print("\nTop articles:")
        for r in d["top_articles"][:10]:
            print(f"  {r['visits']:>6}  {r['src']:<5} {r['article']}")
    if d["revenue"]:
        print("\nCard tips:")
        for r in d["revenue"]:
            print(f"  {r['currency'].upper()}: {money(r['total_cents'])} ({r['tips']})")


def main():
    if not TOKEN:
        sys.exit("INTURIOUS_STATS_TOKEN is not set (it is STATS_TOKEN in the server's .env)")

    cmd = sys.argv[1] if len(sys.argv) > 1 else "overview"
    days = 7 if cmd == "week" else None
    if cmd == "week":
        cmd = "overview"

    try:
        d = fetch(days)
    except urllib.error.HTTPError as e:
        sys.exit(f"{e.code} {e.reason} from {API}")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach {API}: {e.reason}")

    if cmd == "raw":
        print(json.dumps(d, indent=2))
    elif cmd == "top":
        for r in d["top_articles"]:
            print(f"{r['visits']:>6}  {r['src']:<5} {r['article']}")
    elif cmd == "methods":
        for r in d["by_method"]:
            print(f"{r['clicks']:>6}  {r['method']}")
    elif cmd == "revenue":
        for r in d["revenue"]:
            print(f"{r['currency'].upper()}: {money(r['total_cents'])} across {r['tips']} tips")
        if d["revenue_by_article"]:
            print()
        for r in d["revenue_by_article"]:
            print(f"{money(r['total_cents']):>8}  {r['src']:<5} {r['article']}")
    elif cmd == "overview":
        overview(d)
    else:
        sys.exit(f"unknown command: {cmd}")


if __name__ == "__main__":
    main()
