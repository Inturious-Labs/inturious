# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/

# Build outputs
dist/
build/
.cache/

# Vercel (project link metadata — team-specific, not a secret)
.vercel/

# Temporary files
tmp/
temp/
*.tmp
site/scripts/__pycache__/

# Decks - built output (generated by Vercel build). Source lives in site/decks/<slug>/src/.
site/decks/*/index.html
site/decks/*/assets/
site/decks/*/img/
site/decks/*/404.html
site/decks/*/_redirects

# Sitemap (generated by Vercel build)
site/sitemap.xml
