# Copy to .env on the server. Never commit the real file.
PORT=3001
HOST=127.0.0.1
DB_PATH=/var/lib/inturious-api/inturious.db

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=https://tip.inturious.com

# Bearer token for /api/tips/stats. Generate: openssl rand -hex 32
STATS_TOKEN=

# Stripe. Use a restricted key (rk_) scoped to Checkout Sessions write, not a full
# secret key. Test keys (sk_test_/rk_test_) until the flow is proven end to end.
STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe Dashboard, or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the reader after checkout.
TIP_PAGE_URL=https://tip.inturious.com
